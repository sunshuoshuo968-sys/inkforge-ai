{
  "name": "novel-studio",
  "private": true,
  "version": "0.1.0",
  "description": "墨构 - 本地优先的 AI 小说创作工作台",
  "author": "InkForge",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "verify:ui": "node scripts/verify-ui.mjs",
    "electron:dev": "vite --port=4000",
    "dist:win": "pnpm build && electron-builder --win portable --x64",
    "dist:win:dir": "pnpm build && electron-builder --win dir --x64"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "jszip": "^3.10.2",
    "lucide-react": "1.25.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "vite": "5.4.14"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "electron": "35.1.2",
    "electron-builder": "25.1.8",
    "playwright-core": "1.52.0",
    "typescript": "5.7.3"
  },
  "build": {
    "appId": "com.mogou.inkforge",
    "productName": "墨构",
    "copyright": "Copyright © InkForge",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  },
  "packageManager": "pnpm@10.11.0"
}
